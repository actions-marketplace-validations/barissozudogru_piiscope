# Example environment configuration for the GDPR Privacy Application
# Copy this file to `.env` in the project root and adjust values as needed.

DATABASE_URL=postgresql+psycopg2://privacyapp:privacypass@localhost:5432/privacydb
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=supersecretjwtkey
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENCRYPTION_KEY=supersecret16byteskey
DATA_RETENTION_HOURS=24
ALLOW_EGRESS=false
TLS_CERT_FILE=
TLS_KEY_FILE=